# syntax=docker/dockerfile:1

FROM ubuntu:24.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG BUILD_JOBS=8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        extra-cmake-modules \
        fcitx5-modules-dev \
        gettext \
        libfcitx5core-dev \
        librime-data \
        librime-dev \
        ninja-build \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN cmake -S . -B /build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build /build --parallel "${BUILD_JOBS}" \
    && DESTDIR=/out/root cmake --install /build \
    && mkdir -p /out \
    && tar -C /out/root -czf \
        /out/fcitx5-rime-5.1.4-patched.2-runtime.tar.gz \
        .

RUN c++ -std=c++17 tests/verify-navigation.cpp -o /out/verify-navigation $(pkg-config --cflags --libs rime)

FROM scratch
COPY --from=builder /out/fcitx5-rime-5.1.4-patched.2-runtime.tar.gz /
COPY --from=builder /out/verify-navigation /
