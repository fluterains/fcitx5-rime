+cairo_surface_t *XCBInputWindow::prepareFrame(int width, int height) {
+    if (!contentSurface_ || frameWidth_ != width || frameHeight_ != height) {
+        contentSurface_.reset(cairo_surface_create_similar(
+            surface_.get(), CAIRO_CONTENT_COLOR_ALPHA, width, height));
+        frameWidth_ = width;
+        frameHeight_ = height;
+    }
+    if (cairo_surface_status(contentSurface_.get()) != CAIRO_STATUS_SUCCESS) {
+        contentSurface_.reset();
+        return nullptr;
+    }
+    // Reused buffers must not retain glyphs or pixels in transparent corners.
+    auto *cr = cairo_create(contentSurface_.get());
+    cairo_set_operator(cr, CAIRO_OPERATOR_CLEAR);
+    cairo_paint(cr);
+    cairo_destroy(cr);
+    return contentSurface_.get();
+}
